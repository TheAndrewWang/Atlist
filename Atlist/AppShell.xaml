<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Atlist.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Atlist.Views"
    Title="Atlist">

    <TabBar>
        <ShellContent 
            Title="Devices" 
            Route="devices"
            ContentTemplate="{DataTemplate views:DevicesPage}" />
        <ShellContent 
            Title="Send" 
            Route="send"
            ContentTemplate="{DataTemplate views:SendPage}" />
        <ShellContent 
            Title="Schedule" 
            Route="schedule"
            ContentTemplate="{DataTemplate views:SchedulePage}" />
        <ShellContent 
            Title="History" 
            Route="history"
            ContentTemplate="{DataTemplate views:HistoryPage}" />
    </TabBar>

</Shell>
