<?xml version="1.0" encoding="UTF-8" ?>
<!-- Colors and styles from the Checklist Companion mockup, shared by every page. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:conv="clr-namespace:Atlist.Converters">

    <conv:InvertBoolConverter x:Key="InvertBool" />

    <Color x:Key="Ground">#F4F1EA</Color>
    <Color x:Key="Ink">#1F2A2E</Color>
    <Color x:Key="Muted">#56616A</Color>
    <Color x:Key="Accent">#1F6F6B</Color>
    <Color x:Key="AccentSoft">#E4EFEC</Color>
    <Color x:Key="SuccessInk">#145C4A</Color>
    <Color x:Key="SuccessSoft">#DDEFE9</Color>
    <Color x:Key="Warn">#8A4414</Color>
    <Color x:Key="CardLine">#E2DBCC</Color>
    <Color x:Key="FieldLine">#C9BFAC</Color>
    <Color x:Key="WaitSoft">#FFF8F1</Color>
    <Color x:Key="WaitLine">#EBCBAE</Color>
    <Color x:Key="Danger">#A1331F</Color>
    <Color x:Key="Divider">#EEE8DC</Color>
    <Color x:Key="NavLine">#DDD6C8</Color>
    <Color x:Key="LcdGround">#0E1A1F</Color>
    <Color x:Key="LcdBezel">#2B3438</Color>
    <Color x:Key="LcdCell">#15252B</Color>

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="FrauncesSemiBold" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level1" />
    </Style>

    <!-- Small uppercase heading above a group, e.g. "SEND TO" -->
    <Style x:Key="SectionLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="AtkinsonBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CharacterSpacing" Value="0.8" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
        <Setter Property="SemanticProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="Body" TargetType="Label">
        <Setter Property="FontFamily" Value="Atkinson" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
    </Style>

    <Style x:Key="BodyBold" TargetType="Label" BasedOn="{StaticResource Body}">
        <Setter Property="FontFamily" Value="AtkinsonBold" />
    </Style>

    <Style x:Key="Hint" TargetType="Label">
        <Setter Property="FontFamily" Value="Atkinson" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource Muted}" />
    </Style>

    <Style x:Key="Field" TargetType="Entry">
        <Setter Property="FontFamily" Value="Atkinson" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{StaticResource Ink}" />
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="MinimumHeightRequest" Value="46" />
    </Style>

    <!-- Pill-shaped choice. Pages flip it to filled with a DataTrigger when chosen. -->
    <Style x:Key="Chip" TargetType="Button">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource Accent}" />
        <Setter Property="BorderColor" Value="{StaticResource Accent}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="FontFamily" Value="AtkinsonBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="40" />
        <Setter Property="Padding" Value="14,0" />
    </Style>

    <!-- "‹ My devices" link at the top of pushed pages -->
    <Style x:Key="BackLink" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Accent}" />
        <Setter Property="FontFamily" Value="AtkinsonBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="HorizontalOptions" Value="Start" />
    </Style>

    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource BackLink}">
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BackLink}">
        <Setter Property="TextColor" Value="{StaticResource Danger}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="Stroke" Value="{StaticResource CardLine}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <Style x:Key="FilledButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontFamily" Value="AtkinsonBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="White" />
        <Setter Property="TextColor" Value="{StaticResource Accent}" />
        <Setter Property="BorderColor" Value="{StaticResource Accent}" />
        <Setter Property="BorderWidth" Value="2" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontFamily" Value="AtkinsonBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="Padding" Value="18,0" />
    </Style>
</ResourceDictionary>
