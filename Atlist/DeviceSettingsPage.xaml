<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Atlist.ViewModels"
             x:Class="Atlist.Views.DeviceSettingsPage"
             x:DataType="vm:DeviceSettingsViewModel"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Ground}">

    <ScrollView>
        <VerticalStackLayout Padding="20,20,20,24" Spacing="14">

            <!-- Back link, name, pill -->
            <VerticalStackLayout Spacing="6">
                <Button Text="‹  My devices"
                        Style="{StaticResource BackLink}"
                        Command="{Binding BackCommand}"
                        SemanticProperties.Description="Back to My devices" />
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Label Text="{Binding Card.Title}" Style="{StaticResource PageTitle}" VerticalOptions="Center" />
                    <ActivityIndicator Grid.Column="1"
                                       IsVisible="{Binding Card.IsChecking}"
                                       IsRunning="{Binding Card.IsChecking}"
                                       Color="{StaticResource Muted}"
                                       WidthRequest="18" HeightRequest="18" />
                    <Border Grid.Column="2"
                            BackgroundColor="{Binding Card.PillBackground}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 999"
                            Padding="11,5"
                            VerticalOptions="Center">
                        <Label Text="{Binding Card.StatusText}" FontFamily="AtkinsonBold" FontSize="13" TextColor="{Binding Card.PillText}" />
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <!-- Name + location -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Name" Style="{StaticResource BodyBold}" FontSize="14" />
                    <Entry Text="{Binding Name}" Style="{StaticResource Field}" FontSize="16" MaxLength="16"
                           SemanticProperties.Description="Name" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="Location" Style="{StaticResource BodyBold}" FontSize="14" />
                    <Entry Text="{Binding Location}" Style="{StaticResource Field}" FontSize="16" Placeholder="Kitchen counter"
                           SemanticProperties.Description="Location" />
                </VerticalStackLayout>
            </Grid>

            <!-- Resting screen preview -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Resting screen (shown between messages)" Style="{StaticResource BodyBold}" FontSize="14" />
                <Border BackgroundColor="{StaticResource LcdGround}"
                        Stroke="{StaticResource LcdBezel}"
                        StrokeThickness="4"
                        StrokeShape="RoundRectangle 10"
                        Padding="14,10">
                    <SemanticProperties.Description>
                        <MultiBinding StringFormat="Resting screen: {0}, {1}">
                            <Binding Path="RestLine1" />
                            <Binding Path="RestLine2" />
                        </MultiBinding>
                    </SemanticProperties.Description>
                    <VerticalStackLayout>
                        <Label Text="{Binding RestLine1}" FontFamily="LcdFont" FontSize="28" CharacterSpacing="2" MinimumHeightRequest="29" TextColor="{Binding Glow}" />
                        <Label Text="{Binding RestLine2}" FontFamily="LcdFont" FontSize="28" CharacterSpacing="2" MinimumHeightRequest="29" TextColor="{Binding Glow}" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="The top line is the device's name; the bottom line shows its next scheduled time."
                       Style="{StaticResource Hint}" FontSize="13" />
            </VerticalStackLayout>

            <!-- Backlight color -->
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Backlight color" Style="{StaticResource BodyBold}" FontSize="14" />
                    <Label Grid.Column="1" Text="{Binding ColorLabel}" Style="{StaticResource Hint}" />
                </Grid>
                <Grid ColumnDefinitions="*,*,*,*,*,*,*" ColumnSpacing="6" BindableLayout.ItemsSource="{Binding Swatches}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ColorSwatch">
                            <Border Grid.Column="{Binding Index}"
                                    BackgroundColor="{StaticResource LcdGround}"
                                    Stroke="{StaticResource CardLine}"
                                    StrokeThickness="3"
                                    StrokeShape="RoundRectangle 12"
                                    HeightRequest="44"
                                    SemanticProperties.Description="{Binding Label}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DeviceSettingsViewModel}}, Path=PickColorCommand, x:DataType=vm:DeviceSettingsViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Ellipse Fill="{Binding Glow}" WidthRequest="20" HeightRequest="20"
                                         HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </Grid>
            </VerticalStackLayout>

            <!-- Reset cycle + priority -->
            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="56" Padding="14,6">
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Reset cycle" Style="{StaticResource BodyBold}" />
                            <Label Text="Check-off clears after this long" Style="{StaticResource Hint}" FontSize="13" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Button Text="−" Command="{Binding ShorterCommand}" Style="{StaticResource OutlineButton}"
                                    WidthRequest="40" HeightRequest="40" MinimumHeightRequest="40" Padding="0" CornerRadius="10" FontSize="20"
                                    SemanticProperties.Description="Shorter" />
                            <Label Text="{Binding ResetText}" Style="{StaticResource BodyBold}" WidthRequest="44"
                                   HorizontalTextAlignment="Center" VerticalOptions="Center" />
                            <Button Text="+" Command="{Binding LongerCommand}" Style="{StaticResource OutlineButton}"
                                    WidthRequest="40" HeightRequest="40" MinimumHeightRequest="40" Padding="0" CornerRadius="10" FontSize="20"
                                    SemanticProperties.Description="Longer" />
                        </HorizontalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="{StaticResource Divider}" />
                    <Grid ColumnDefinitions="*,Auto" MinimumHeightRequest="56" Padding="14,6">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TogglePriorityCommand}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="High priority" Style="{StaticResource BodyBold}" />
                            <Label Text="Beep when a reminder comes due" Style="{StaticResource Hint}" FontSize="13" />
                        </VerticalStackLayout>
                        <CheckBox Grid.Column="1" IsChecked="{Binding HighPriority}" Color="{StaticResource Accent}"
                                  VerticalOptions="Center" SemanticProperties.Description="High priority" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="Test screen" Command="{Binding TestScreenCommand}" Style="{StaticResource OutlineButton}" MinimumHeightRequest="48" />
                <Button Grid.Column="1" Text="Sync clock" Command="{Binding SyncClockCommand}" Style="{StaticResource OutlineButton}" MinimumHeightRequest="48" />
            </Grid>

            <Button Text="Save to device"
                    Command="{Binding SaveToDeviceCommand}"
                    Style="{StaticResource FilledButton}"
                    MinimumHeightRequest="48" />

            <Label Text="{Binding StatusText}"
                   Style="{StaticResource Hint}"
                   FontSize="15"
                   HorizontalTextAlignment="Center"
                   SemanticProperties.Description="{Binding StatusText}" />

            <Button Text="Forget this device"
                    Command="{Binding ForgetCommand}"
                    Style="{StaticResource DangerButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
